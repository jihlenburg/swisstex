% swissidentity-acme.sty
% Referenzidentität der SwissTeX-Klasse (v2.0). "acme" ist ein neutraler
% Platzhaltername, keine echte Firma -- diese Datei zeigt, wie eine
% Identität sämtliche öffentlichen Setzer aus swisstex.cls Abschnitt 2b
% benutzt, ausschliesslich über diese Setzer, nie über internes Patchen der
% Klasse. Sie dient zugleich als Grundlage von acme-demo.tex, dem
% Referenzdokument der Identitätsschicht (Aufgabe 8 des v2.0-Plans).
\ProvidesPackage{swissidentity-acme}[2026/07/30 SwissTeX Referenzidentitaet acme]

\swissidentitymeta{company={Acme AG}, legal={Sitz Musterstadt · HRB 12345},
  web={acme.example}}

% Farbrollen. Kein eigener band=-Wert: das Band bleibt damit = accent
% (Abschnitt 2b, v2.0-Vorgabe seit dem Wegfall des zweiten, unmotivierten
% Rots -- Müller-Brockmanns Regel gegen zwei Signalfarben nebeneinander).
\swisssetcolors{accent={200,16,46}, paper={245,244,238}, ink={26,26,26}}

% Schriftanbieter (I4). Ersetzt die Vorgabeschrift der Klasse vollständig:
% \setmainfont für den Grundtext, \renewfontfamily (NICHT \newfontfamily --
% \condensed ist bereits deklariert, siehe der Kommentar an der
% Anbieter-Weiche in swisstex.cls Abschnitt 3) für die Schmalschrift, und
% ein eigener \setmathfont, damit auch die Mathematik auf derselben
% Familie steht statt stillschweigend bei der Vorgabe-Mathematik zu bleiben.
% Diese Vollständigkeit ist die Pflicht des Anbieters, die die Klasse selbst
% nicht erzwingt -- genau das prüft acme-demo.tex/tests/test_acme.py
% end-to-end (nur SwissTeXGrotesk*/Cond*-Namen, kein TeX Gyre Heros, im
% fertigen PDF).
\newcommand{\swissidentityfonts}{%
  \setmainfont{SwissTeX Grotesk}%
  \renewfontfamily\condensed{SwissTeX Grotesk Condensed}%
  \setmathfont{TeX Gyre DejaVu Math}}

\swisslogofiles{cover=acme-logo.pdf, colophon=acme-logo.pdf}

\swissclassifications{public,internal,confidential,strict}

\swissfootformat{\meta{docid} · \meta{version} · \meta{date}}

% Umschlagvariante "report": Vorgabeband (Zeile 38, neun Zeilen hoch) und
% Zeichen-Grundlinie auf Zeile 30, falls ein Dokument glyph= setzt. Nur
% deklariert, hier nicht angewendet -- ein Dokument ruft
% \swisscover*{variant=report, ...} selbst auf (siehe acme-demo.tex).
% Direkter Aufruf im Dateikoerper, wie jeder andere Setzer in dieser Datei:
% \swisscovervariant ist seit swisstex.cls Fix Round 1 (Task 8) in
% Abschnitt 2b definiert, VOR der Identitaetsladung (siehe der Kommentar
% dort), darum an dieser Stelle unmittelbar aufrufbar.
\swisscovervariant{report}{band=38/9, glyphline=30}
